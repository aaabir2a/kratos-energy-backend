# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=Kratos CRM API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,https://www.kratos-energy.com,https://kratos-energy.com

# ── Database (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://kratos:kratos@localhost:5432/kratos_crm?schema=public

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Security ──────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ── Seed admin (first boot) ───────────────────────────
SEED_ADMIN_EMAIL=admin@kratosenergy.com.au
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Admin

# Intake webhooks (social/chatbot)
INTAKE_WEBHOOK_SECRET=change_me_webhook_secret_16+

# ── Email notifications ───────────────────────────────
# Provider: auto (default, prefers Resend) | resend | smtp.
# Leave everything blank to disable email — in-app notifications still work.
MAIL_PROVIDER=auto
# Resend (preferred — it signs DKIM + publishes SPF for your verified domain)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MUST be on a domain verified with the provider, or mail lands in spam.
MAIL_FROM=Kratos Sustainability <crm@send.kratos-energy.com>
MAIL_REPLY_TO=info@kratos-energy.com
# SMTP fallback (Gmail needs a 16-char App Password, not the account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Deep links in emails
APP_BASE_URL=http://localhost:5173
# Fallback shared recipients until set in Administration → Notifications
NOTIFY_ADMIN_EMAILS=

# Chatbot platform integration (CRM_DEVELOPER_GUIDE)
CHATBOT_API_BASE=https://api.ambrosianuk.com
CHATBOT_CRM_KEY=crm_xxx_from_dashboard
CHATBOT_WEBHOOK_SECRET=whsec_xxx_from_dashboard
